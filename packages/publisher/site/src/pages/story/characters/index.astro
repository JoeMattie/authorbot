---
import Icon from "../../../components/Icon.astro";
import Base from "../../../layouts/Base.astro";
import { site } from "virtual:authorbot-site";

const portraits = site.characters.flatMap((character) =>
  character.image === undefined
    ? []
    : [{ slug: character.slug, name: character.name, image: character.image }],
);
---

<Base title={`Characters · ${site.book.title}`} activeNav="characters">
  <div class="story-page story-characters-page">
    <header class="story-page-header">
      <p class="story-eyebrow">Characters</p>
      <h1>Who is in the room</h1>
    </header>
    {
      site.characters.length === 0 ? (
        <p class="story-empty">This book has no character records yet.</p>
      ) : (
        <ul class="character-grid">
          {site.characters.map((character) =>
            character.image !== undefined ? (
              <li>
                <div class="character-card character-card-with-image">
                  <a class="character-card-main" href={character.href}>
                    <div class="character-card-heading">
                      <span class="character-card-copy">
                        <strong>{character.name}</strong>
                        <span class="character-card-meta">
                          {character.aliases.length > 0 && `${character.aliases.join(", ")} · `}
                          {character.chapters.length} {character.chapters.length === 1 ? "chapter" : "chapters"}
                        </span>
                      </span>
                      <Icon name="chevron-right" size={17} class="character-card-arrow" />
                    </div>
                    {character.summary && <span class="character-card-summary">{character.summary}</span>}
                  </a>
                  <a
                    class="character-card-portrait"
                    href={`#character-image-${character.slug}`}
                    aria-label={`View portrait of ${character.name} full size`}
                  >
                    <img
                      src={character.image.thumb}
                      alt={`Portrait of ${character.name}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </div>
              </li>
            ) : (
              <li>
                <a class="character-card" href={character.href}>
                  <div class="character-card-heading">
                    <span class="character-card-copy">
                      <strong>{character.name}</strong>
                      <span class="character-card-meta">
                        {character.aliases.length > 0 && `${character.aliases.join(", ")} · `}
                        {character.chapters.length} {character.chapters.length === 1 ? "chapter" : "chapters"}
                      </span>
                    </span>
                    <Icon name="chevron-right" size={17} class="character-card-arrow" />
                  </div>
                  {character.summary && <span class="character-card-summary">{character.summary}</span>}
                </a>
              </li>
            ),
          )}
        </ul>
      )
    }
  </div>
  {
    /* Script-free portrait lightboxes, the same `:target` mechanism as the
       cover art on the landing page: a thumbnail links to its overlay's
       fragment, and closing is a link back to an inert fragment. */
    portraits.map((portrait) => (
      <div
        class="cover-modal"
        id={`character-image-${portrait.slug}`}
        role="dialog"
        aria-label={`Portrait of ${portrait.name}`}
      >
        <a class="cover-modal-backdrop" href="#_" aria-label="Close"></a>
        <figure class="cover-modal-body">
          <img src={portrait.image.full} alt={`Portrait of ${portrait.name}`} loading="lazy" decoding="async" />
          <figcaption>
            <span>{portrait.name}</span>
            <a href={portrait.image.full} target="_blank" rel="noopener">Open original</a>
            <a class="cover-modal-close" href="#_">Close</a>
          </figcaption>
        </figure>
      </div>
    ))
  }
</Base>
